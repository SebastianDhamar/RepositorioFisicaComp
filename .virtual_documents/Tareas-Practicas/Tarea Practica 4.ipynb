import numpy as np
def IntegracionSimpson2(f,a,b,N):
    h=(b-a)/N
    if N%2==0:
        I1=(f(a)+f(b))
        S1=0
        S2=0
        for i in range(1,int(N/2)+1):
            S1+=f(a+(((2*i)-1)*h))

        for i in range(1,(int(N/2))):
            S2+=f(a+(2*i*h))

        return (h/3)*(I1+(4*S1)+(2*S2))
    elif N%2!=0:
        return print("N debe ser par")


