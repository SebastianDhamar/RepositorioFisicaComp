import math as mt
def H(n,x):
    if n==0:
        return 1
    elif n==1:
        return 2*x
    elif n>=2:
        # return (2*x*H(n-1,x))-(2*(n-1)*H(n-2,x))
        h_2 = np.ones_like(x,dtype=float)
        h_1 = 2*x
        for i in range(1, n):
            h = 2.0 * x * h_1 - 2.0 * i * h_2
            h_2 = h_1
            h_1 = h
        return h

def psi(n,x):
    if n>=0:
        return (1/np.sqrt((2**n)*mt.factorial(n)*np.sqrt(np.pi)))*np.exp((-x**2)/2.0)*H(n,x)


