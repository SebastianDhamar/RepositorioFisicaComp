def Cv(T):
    N=50
    V=1000*10**(-6)
    rho=6.022*10**28
    thetaD=428
    kB=1.380649*10**(-23)
    a=0
    b=thetaD/T    
    x_k,w_k=np.polynomial.legendre.leggauss(N)

    xk=((b-a)/2)*x_k +((b+a)/2)
    wk=((b-a)/2)*w_k
    
    def f(x):
        return ((x**4)*(np.exp(x)))/(((np.exp(x)-1)**2))
    S=0
    for i in range(len(xk)):
        S+=(wk[i])*f(xk[i])
    
    return float(9*V*rho*kB*((T/thetaD)**3)*S)


