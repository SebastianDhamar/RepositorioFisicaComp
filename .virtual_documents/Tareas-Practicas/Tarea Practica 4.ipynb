





import numpy as np
def metTrapecio(f,a,b,N):
    h=(b-a)/N
    I1=(f(a)+f(b))
    S1=0
    for i in range(1,int(N)):
        S1+=f(a+(i*h))
    return float(h*((I1/2)+S1))


