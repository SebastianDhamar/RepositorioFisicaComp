L = 10
M = 10000
sigma = M / (L**2) 
G = 6.674*10**(-11)
N = 100
a= -L/2
b = L/2
x_k, w_k = np.polynomial.legendre.leggauss(N)
xk = ((b-a)/2)*x_k+((b+a)/2)
wk = ((b-a)/2)*w_k

X, Y = np.meshgrid(xk, xk)
Wx,Wy = np.meshgrid(wk, wk)
W= Wx*Wy


def grav(z):
    if z == 0:
        return 0
    f= 1/((X**2 + Y**2 + z**2)**(3/2))
    S = np.sum(W * f)
    return G*sigma*z*S


Z = np.linspace(0, 10, 300)
F=[]
for z in Z:
    za=grav(z)
    F.append(za)

plt.plot(Z, F, color='red')
