








import math as mt

r = float(input("Introduce el valor de r = "))
theta = float(input("Introduce, en grados, el valor de Theta= "))
theta = mt.radians(theta)


x = r*(mt.cos(theta))
y = r*(mt.sin(theta))

x = round(x,4)
y = round(y,4)

x = str(x)
y =str(y)

print("Tus coordenadas son x: " + x)
print("y: " + y)











import math as mt

x = float(input("Introduce el valor de la coordenada x = "))
y = float(input("Introduce el valor de la coordenada y = "))

r = mt.sqrt((x**2)+(y**2))

if x == 0:
    t = mt.atan2(y,x)
else:
    t = mt.atan(y/x)

t = mt.degrees(t)

r = round(r,5)
t = round(t,5)

r = str(r)
t = str(t)

print("Tus coordenadas polares son r = " + r + ", y theta = " + t + "°")











