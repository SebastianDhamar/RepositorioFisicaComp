import math as mt

m = 9.11*(10**(-31))
E = 10
V = 9
h = 6.63*(10**(-34))
hb = h/(2*mt.pi)


k1 = (mt.sqrt(2*m*E))/hb
k2 = (mt.sqrt(2*m*(E-V)))/hb

T = (4*k1*k2)/((k1+k2)**2)
R = ((k1-k2)/(k1+k2))**2

# One = T + R

T = str(T)
R = str(R)


print("La posibilidad de transmisión es " + T)
print("La posibilidad de reflectores es " + R)
