import numpy as np

a1=15.8
a2=18.3
a3=0.714
a4=23.2

x=0
y=0
for Z in range(1,101):
    xi=0
    yi=0
    for A in range(int(Z),int(3*Z)+1):
        if A%2!=0:
            a5=0.0
        elif A%2==0 and Z%2==0:
            a5=12.0
        elif A%2==0 and Z%2!=0:
            a5=-12.0
        B=(a1*A)-(a2*(A**(2/3)))-(a3*((Z**2)/(A**(1/3))))-(a4*(((A-(2*Z))**2)/A))+a5/(A**(1/2))
        UpN = B/A
        if UpN>xi:
            yi=A
            xi=UpN
        else:
            continue
    print("Para Z=",Z,", el valor mas estable de A es =",yi)
    if xi>x:
        y=Z
        x=xi
    else:
        continue
    
print("El nucleo atomico Z=",y," es el que produce la mayor energia por nucleon siendo de ",x,"MeV")





def factorr(n):
    if n == 1 or n==0:
        return 1
    else:
        return n*factorr(n-1)


def binomial(n,k):
    if n<k:
        return("n debe ser Mayor que k")
    elif k==0:
        return 1
    elif n==k:
        return 1
    else:
        return int(((factorr(n))/((factorr(k))*(factorr(n-k)))))
        # n Debe ser mayor que k siempre!


