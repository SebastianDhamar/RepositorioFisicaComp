def Cat(n):
    if n==0:
        return 1
    elif n<0:
        return print("n debe ser positiva")
    elif n>0:
        return (((4*n)-2)/(n+1))*Cat(n-1)


Cat(100)





def g(m,n):
    if type(n)!=int or type(m)!=int or n<0 or m<0:
        return print("Deben ser numeros enteros no negativos")
    elif n==0:
        return m
    elif n>0:
        return g(n,m%n)


