import matplotlib.pyplot as plt
import numpy as np

tiempo=[]
manchas=[]
r=5
Yk=[]
tiempo_Yk=[]

datos = open("data/manchasolares.txt", "r")
for linea in datos:
    l=linea.split()
    tiempo.append(float(l[0]))
    manchas.append(float(l[1]))
    if len(tiempo)==1000:
        break
    else:
        continue

for k in range(r, len(manchas) - r):
    suma = 0.0
    for m in range(-r, r + 1):
        suma = suma+manchas[k + m]
    
    media = (1/((2 * r )+ 1))*suma
    Yk.append(media)
    tiempo_Yk.append(tiempo[k])

plt.plot(tiempo,manchas, label="Datos experimentales", color="yellow")
plt.plot(tiempo_Yk, Yk, "r",label="Media")
plt.xlabel("Tiempo en meses")
plt.ylabel("Numero de Manchas")
plt.axhline(y = 0.0, xmin = 0.0, color = 'black')
plt.axvline(x = 0.0, ymin = 0.0, color = 'black')
plt.legend()
plt.grid()
plt.show





import matplotlib.pyplot as plt
import numpy as np

ran=np.arange(1,4,0.01)

R=[]
Feig=[]
for r in ran:
    xn=0.5
    for _ in range(1000):
        xn = r * xn * (1.0 - xn)
    for _ in range(1000):
        xn = r * xn * (1.0 - xn)
        Feig.append(xn)
        R.append(r)

plt.figure(figsize=(10, 6))
plt.plot(R, Feig, 'g.', markersize=1)
plt.title("Grafica de Feigenbaum")
plt.xlabel("r",fontsize=13)
plt.ylabel("$x_n$",fontsize=13)
plt.xlim(1.0, 4.0)
plt.grid()















import matplotlib.pyplot as plt
import numpy as np

ran=np.arange(1,4,0.01)
r=np.array(ran)
x=np.full(len(r), 0.5)

plt.figure(figsize=(10, 6))

for _ in range(1000):
    x = r*x*(1-x)
for _ in range(1000):
    x = r*x*(1-x)
    plt.plot(r, x, '.', markersize=1)
# x = r*x*(1-x)
# r.map(x = r*x*(1-x))

# plt.plot(r, x, '.',color="green")
plt.title("Grafica de Feigenbaum")
plt.xlabel("r",fontsize=13)
plt.ylabel("$x_n$",fontsize=13)
plt.xlim(1.0, 4.0)
plt.grid()
plt.show()











import matplotlib.pyplot as plt
import numpy as np

z0=0
n = 1000
N = 100
x=np.linspace(-2,2,n)
y=np.linspace(-2,2,n)
X,Y=np.meshgrid(x,y)

c=X+(Y*1j)

z = np.zeros_like(c)
for _ in range(N):
    z = z**2 + c
C = np.abs(z) <= 2

plt.imshow(~C, extent=[-2, 2, -2, 2],origin='lower')
plt.xlabel("Re(c)",fontsize=13)
plt.ylabel("Im(c)",fontsize=13)
plt.grid()
plt.gray()





