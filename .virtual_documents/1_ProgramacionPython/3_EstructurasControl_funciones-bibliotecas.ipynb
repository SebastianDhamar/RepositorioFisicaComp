# Usando la ecuacion que da este ejercicio me salen numeros negativos para los numeros de catalan, usando la ecuacion que se habia proporcionado antes el resultado me da como se espera

def cat(n):
    if n == 0:
        c = 1
    else:
        if n > 0:
            c_1 = 1
            for i in range(0,n):
                Cn = c_1
                c_1 = (((4*i)+2)/(i+2))*Cn
            c = (((4*n)+2)/(n+2))*(c_1)
    return c


