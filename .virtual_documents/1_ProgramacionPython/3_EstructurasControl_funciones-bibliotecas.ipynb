def factor(n):
    if n == 1:
        f = 1
    else:
        if n> 1:
            N = 1
            for i in range(1,n):
                N = N*i
            f= n*N
    return f


factor(5)


def factorr(n):
    if n == 1:
        return 1
    else:
        return n*factorr(n-1)


factorr(5)





