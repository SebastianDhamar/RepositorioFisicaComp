# Esta regresa los numeros de fibonacci menores a n
def fibonacci(n):
    
    output = []
    
    f1,f2 = 1,1

    while f2 < n:
        output.append(f2)        
        f1,f2 = f2,f1+f2
    
    return output



fibonacci(10)


##Esta regresa los primeros n numeros de fibonacci
def fibonacci2(n):
    
    output = []
    
    f1,f2 = 1,1

    for i in range(1,n+1):
        output.append(f2)        
        f1,f2 = f2,f1+f2
    
    return output



fibonacci2(10)


fibo = fibonacci(100)

outputBuff = open("fibonacci.dat", "w")

for n in fibo:
    outputBuff.write("%d \n" % n)
#     outputBuff.write("%f \n" % n)

outputBuff.close()


fibo2 = fibonacci(1000)

with open("fibonacci2.dat", 'a') as out:
    for n in fibo2:
        out.write(str(n) + '\n')


