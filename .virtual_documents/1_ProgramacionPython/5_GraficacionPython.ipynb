import math as mt

phi = (1 + mt.sqrt(5))/2
f1,f2 = 1,1

Fibonacci = []
Time = []

t = 0.0

n = 1000000
print("Para n =",n)

while f2 <= n:
    
    fn = f2/f1
    Fibonacci.append(fn)
    Time.append(t)
    t = t + 1
    
    print("la diferencia con phi es: ",phi-fn)
    f1,f2 = f2,f1+f2





