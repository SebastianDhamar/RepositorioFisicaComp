   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "x=0.3\n",
    "r=3.6\n",
    "n=100\n",
    "X=[]\n",
    "for i in range(n):\n",
    "    x=Logis(r,x)\n",
    "    X.append(x)\n",
    "    \n",
    "plt.plot(X,\"r.-\", markersize=5)\n",
    "plt.grid()\n",
    "plt.show"
   ]
